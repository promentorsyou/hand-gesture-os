# Copy to .env and adjust.

HANDGESTURE_HOST=127.0.0.1
HANDGESTURE_PORT=8000

# Force the null adapter (no real OS control). Recommended while testing.
HANDGESTURE_SIMULATE=0

# Path to the gesture config.
HANDGESTURE_CONFIG=config/gestures.yaml

# Active profile from config/profiles/.
HANDGESTURE_PROFILE=default

# Shared secret for mobile companion pairing (Phase 5). Generate your own.
HANDGESTURE_PAIRING_SECRET=

LOG_LEVEL=info
